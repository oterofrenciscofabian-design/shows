# Copia a .env para desarrollo local. Nunca añadas secretos reales a Git.
APP_PASSWORD=replace-with-a-random-password-at-least-16-chars
MCP_SECRET=replace-with-random-secret-at-least-32-characters
HF_TOKEN=
GITHUB_TOKEN=
OLLAMA_HOST=http://host.docker.internal:11434
AGENT_MODEL=deepseek-coder-v2
QWEN_MODEL=qwen2.5:7b
DEEPSEEK_MODEL=deepseek-coder-v2
DOLPHIN_MODEL=dolphin-llama3
MISTRAL_MODEL=mistral:7b
COOKIE_SECURE=false
TRUSTED_HOSTS=localhost,127.0.0.1,host.docker.internal

# TTS opcional
PIPER_MODEL=
KOKORO_LANG=a
KOKORO_VOICE=af_heart
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# Modelos opcionales para caption/upscale via MCP
IMAGE_CAPTION_MODEL=Salesforce/blip-image-captioning-base
IMAGE_UPSCALE_MODEL=caidas/swin2SR-classical-sr-x2-64

# ComfyUI opcional. Exporta los workflows en formato API.
COMFYUI_URL=
COMFYUI_IMAGE_WORKFLOW=
COMFYUI_VIDEO_WORKFLOW=
COMFYUI_PROMPT_NODE_ID=
COMFYUI_PROMPT_INPUT=text
COMFYUI_TIMEOUT=300

# Telegram Mini App opcional: bot token y IDs numéricos autorizados.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
